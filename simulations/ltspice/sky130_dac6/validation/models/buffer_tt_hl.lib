rs1 a        b1 R={(r1)*(1+(tc1rm3)*(PDK_TEMP-27)+(tc2rm3)*(PDK_TEMP-27)**2)}
rs2 b1        c1 R={(r2)*(1+(tc1rvia3)*(PDK_TEMP-27)+(tc2rvia3)*(PDK_TEMP-27)**2)}
