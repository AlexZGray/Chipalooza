# Local operating-system and Python files.
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.venv/

# LTspice regenerates these beside source schematics, including subfolders.
/simulations/ltspice/**/*.raw
/simulations/ltspice/**/*.log
/simulations/ltspice/**/*.net
/simulations/ltspice/**/*.bak
/simulations/ltspice/**/*.bck
/simulations/ltspice/**/*.db
/simulations/ltspice/**/*.sqlite
/simulations/ltspice/**/*.asc~
/simulations/ltspice/**/*.asy~

# Fresh verification output; committed reference measurements remain unchanged.
/simulations/ltspice/**/results/latest.json
/simulations/ltspice/**/results/latest_all_codes.csv

# Sky130 verification work files and automatically exported netlists.
/simulations/ltspice/sky130_dac6/**/*.generated.txt
/simulations/ltspice/sky130_dac6/**/*.log.json
/simulations/ltspice/sky130_dac6/results/latest*
/simulations/ltspice/sky130_dac6/validation/.work/
